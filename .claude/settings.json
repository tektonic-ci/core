{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/beads-session-start.sh",
            "statusMessage": "Syncing beads\u2026",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(flox activate -- npm*)",
      "Bash(flox activate -- bd*)",
      "Bash(flox activate -- repomix*)",
      "Bash(bd*)",
      "Bash(npm test*)",
      "Bash(npm run*)",
      "Bash(npx vitest*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git show*)"
    ]
  }
}
